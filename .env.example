# Copy to .env.local and fill in real values. Never commit .env.local.

# Canonical site URL, used for metadata, canonical tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://www.kala-academy.example

# Search indexing. Off unless this is exactly "true" (robots.txt disallows everything and every
# page is noindex). Set it on the production launch deployment only, never on review/staging.
NEXT_PUBLIC_ALLOW_INDEXING=

# Photography placeholders. Until a photo exists, visitors see a calm blush frame with a
# faint monogram. The shot brief ("Photography pending — …") for each empty slot only shows in
# development; set this to "true" on a review deployment if the team needs to see the briefs.
NEXT_PUBLIC_SHOW_PHOTO_BRIEFS=

# Public WhatsApp number for click-to-chat links (digits only, with country code, e.g. 9198XXXXXXXX).
# This is intentionally public — it is the number visitors message, not a credential.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Leads API — server-side only, never exposed to the client.
# Destination for new enquiries once a real CRM/DB/webhook is chosen (Phase: Lead Backend).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Rate limiting / spam protection for public forms (values are placeholders).
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=60
