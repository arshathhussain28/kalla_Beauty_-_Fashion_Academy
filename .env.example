# Copy to .env.local and fill in real values. Never commit .env.local.

# Canonical site URL, used for metadata, canonical tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://www.kala-academy.example

# Search indexing. Off unless this is exactly "true" (robots.txt disallows everything and every
# page is noindex). Set it on the production launch deployment only, never on review/staging.
NEXT_PUBLIC_ALLOW_INDEXING=

# Photography placeholders. Until a photo exists, visitors see a calm blush frame with a
# faint monogram. The shot brief ("Photography pending — …") for each empty slot only shows in
# development; set this to "true" on a review deployment if the team needs to see the briefs.
NEXT_PUBLIC_SHOW_PHOTO_BRIEFS=

# Public WhatsApp number for click-to-chat links (digits only, with country code, e.g. 9198XXXXXXXX).
# This is intentionally public — it is the number visitors message, not a credential.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Leads API — server-side only, never exposed to the client (never prefix with NEXT_PUBLIC_).
#
# LEADS_WEBHOOK_URL is where every enquiry is delivered: the form POSTs to /api/leads, which
# POSTs the lead as JSON to this URL (https only in production). Point it at whatever receives
# enquiries — a CRM/automation webhook (Zapier, Make, n8n), a Google Apps Script web app that
# appends to a sheet, or a small endpoint of your own.
#
# IMPORTANT: until this is set in the production environment, the enquiry form does NOT accept
# leads — /api/leads answers 503 and the form tells the visitor to use WhatsApp or the phone.
# That is deliberate: the site never says "Thank you" for an enquiry that nobody received.
# (In `next dev` an unset URL just logs the lead to the terminal so the form can be built.)
#
# Request the receiver gets (Content-Type: application/json):
#   { id, interest, goal, name, phone, preferredContactTime?, source?, campaign?, courseSlug?,
#     createdAt, status: "new" }
# Headers: X-KALA-Event: lead.created, X-KALA-Lead-Id, X-KALA-Timestamp (unix seconds) and,
# when LEADS_WEBHOOK_SECRET is set, X-KALA-Signature: sha256=<hex HMAC-SHA256 of
# "<timestamp>.<raw body>" using the secret> — verify it and reject anything older than a few
# minutes. The receiver must answer 2xx within 8 seconds; anything else is shown to the visitor
# as "couldn't take your enquiry online", and the lead id is written to the server log (no
# name or number is ever logged).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Rate limiting / spam protection for the public form. Positive whole numbers; anything else
# (including an empty value) falls back to 5 requests per 60 seconds per client.
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=60
